# Database (PostgreSQL)
DATABASE_URL="postgresql://toppot:toppot@localhost:5432/toppot?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site URL used in Stripe redirects, sitemap, and metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="ReachTheTop"

# Stripe Payment Link (fixed opening bid, e.g. $8)
STRIPE_PAYMENT_LINK_URL="https://buy.stripe.com/14A28tddf7993de9mpbEA04"
STRIPE_PAYMENT_LINK_AMOUNT_CENTS="800"

# Stripe API keys — required for bids above the payment-link amount and for webhooks
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
